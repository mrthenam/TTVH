# Sao chép file này thành ".env" và điền giá trị thật (cho chạy LOCAL).
# Khi DEPLOY (Railway/Render): nhập các biến này trong dashboard nền tảng,
# KHÔNG đẩy file .env thật lên GitHub. Để trống PORT để nền tảng tự cấp.

# Cổng máy chủ
PORT=8787

# Khoá API Gemini (lấy ở https://aistudio.google.com/apikey). KHÔNG commit khoá thật.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Đăng nhập nhân viên ---
# Chuỗi bí mật để ký JWT (đổi thành chuỗi ngẫu nhiên dài).
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
# Tài khoản nhân viên đầu tiên được tạo tự động khi DB trống.
AGENT_DEFAULT_USER=admin
AGENT_DEFAULT_PASS=admin123

# --- Cơ sở dữ liệu ---
# Bỏ trống => dùng JSON (data/store.json) cho dev.
# Điền chuỗi kết nối Postgres để dùng Postgres, ví dụ:
# DATABASE_URL=postgres://ttvh:ttvh@localhost:5432/ttvh
DATABASE_URL=
# Đặt true nếu Postgres yêu cầu SSL (nhiều dịch vụ cloud).
PGSSL=false
